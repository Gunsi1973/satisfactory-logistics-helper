# --- Grist -----------------------------------------------------------------
GRIST_TAG=1.7.20
TZ=Europe/Zurich
# 127.0.0.1 = only this PC. A LAN IP gives everyone on the LAN full access (no login).
GRIST_BIND=127.0.0.1
GRIST_PORT=8484
# Identity used by "Sign in" in single-user mode
GRIST_DEFAULT_EMAIL=you@example.com

# --- Sync ------------------------------------------------------------------
PYTHON_TAG=3.13-alpine
# FRM web server. Default works on Docker Desktop (Windows/macOS) and Linux without firewall.
FRM_URL=http://host.docker.internal:8080
SYNC_INTERVAL=120
# From the document URL: http://127.0.0.1:8484/o/docs/<GRIST_DOC_ID>/...
GRIST_DOC_ID=xxx
# Grist: avatar -> Profile Settings -> API -> Create
GRIST_API_KEY=xxx

# --- Linux with a firewall blocking Docker -> host (e.g. ufw) ----------------
# Uncomment both lines (see docker-compose.hostnet.yml):
# COMPOSE_FILE=docker-compose.yml:docker-compose.hostnet.yml
# FRM_URL=http://127.0.0.1:8080
